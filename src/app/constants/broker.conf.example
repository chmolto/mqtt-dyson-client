# Copy to broker.conf (git-ignored) and fill in your device details.
# Run with: mosquitto -c broker.conf

log_type all

listener 9001
protocol websockets
allow_anonymous true

listener 1883
protocol mqtt
allow_anonymous true

#bridge
connection bridge-01
# Local IP of your Dyson fan (check your router)
address 192.168.1.50:1883
remote_clientid dyson-bridge
# Device credentials (see README: "Getting your fan's credentials")
remote_username YOUR-DEVICE-SERIAL
remote_password YOUR-DEVICE-PASSWORD
bridge_protocol_version mqttv311
try_private false
notifications false
cleansession true

topic # out 0
topic 438/YOUR-DEVICE-SERIAL/status/current in 0